<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://myiptv.app/player" version="0.2.0" viewmodes="maximized">
    <tizen:application id="MyIPTV0001.MyIPTV" package="MyIPTV0001" required_version="5.0"/>
    <name>MyIPTV</name>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <!-- Les flux IPTV sont servis par de nombreux domaines : accès réseau sans restriction d'origine. -->
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>
</widget>
