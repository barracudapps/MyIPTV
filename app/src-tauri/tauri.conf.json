{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyIPTV",
  "version": "0.4.0",
  "identifier": "app.myiptv.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyIPTV",
        "width": 1280,
        "height": 780,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#0b0d12",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RTlGNUM4NjU4OERDNkYKUldSdjNJaGx5UFhwWlRuM25uNTdoTGM4UXVjRVA2NkxjaHgzdlI0Um10Qi9nY0F5Z3owbTg1STAK",
      "endpoints": [
        "https://github.com/barracudapps/MyIPTV/releases/latest/download/latest.json"
      ]
    }
  }
}
